# ============================================================
# emprestAI_frontend — exemplo de variáveis de ambiente
# (referência: ADR-001 — Stack, mantido no repo da API `emprestAI`)
#
# Como usar:
#   - Local: copie este arquivo para .env e preencha os valores.
#   - Produção: setar na Vercel em Project Settings > Environment
#     Variables (uma vez por ambiente: Development/Preview/Production).
#   - CI (GitHub Actions): setar como repository secrets.
#
# NUNCA commitar .env (ver .gitignore).
#
# Segurança: aqui só entram valores públicos (anon key e URLs).
# service_role, senha de banco e JWT secret vivem APENAS na API
# (repo emprestAI). O front nunca fala direto com o banco.
# ============================================================

# ------------------------------------------------------------
# SUPABASE AUTH (login e sessão)
# O prefixo VITE_ é obrigatório para a variável ser exposta no
# bundle pelo Vite. O supabase-js cuida de login, renovação do
# token e persistência da sessão; o token vai no header para a API.
# ------------------------------------------------------------

# URL do projeto Supabase
# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" do Supabase — a única que pode ir no front
# (a anon key é segura em público; a service_role nunca).
# Supabase > Project Settings > API > API Keys > anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...  # preencha com a anon public

# ------------------------------------------------------------
# API (repo emprestAI · NestJS · deploy na Vercel)
# É a base do cliente HTTP gerado pelo orval (rotas /v1).
# ------------------------------------------------------------

# URL base da API para as chamadas REST
#   Local:    http://localhost:3000  (porta do `npm run start:dev` da API)
#   Produção: https://SEU-PROJETO-api.vercel.app  (projeto Vercel da API)
#   Frontend publicado em: https://emprestaifrontend.vercel.app/
VITE_API_URL=http://localhost:3000

# Produção: URL do projeto Vercel da API, sem barra final.
# Exemplo: https://emprestai-api.vercel.app
